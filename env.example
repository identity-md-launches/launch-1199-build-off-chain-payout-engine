# Copy to a local environment file for NONSECRET settings. Shell-source it with `set -a`.
# The payout key is supplied separately through the process environment; never put it in this file.

# Launch deployment metadata and the exact verified ABIs; see launch.example.json.
LAUNCH_FILE=launch.json
# State + public snapshots. Use a DIFFERENT directory for live and dry-run histories.
DATA_DIR=data
# dry-run computes historical ledgers and previews without constructing a signer. live sends.
EXECUTOR=dry-run
# Live only. Export interactively/from a secret manager, not from a committed file.
# PAYOUT_PRIVATE_KEY=

# Comma-separated Robinhood Chain (4663) HTTP(S) endpoints; all must be healthy for a safe head.
RPC_URLS=
# Dedicated log endpoint; blank uses the first RPC_URLS entry outside payout rounds.
RPC_LOGS_URL=
# Required. All reads and writes inside execution are pinned here; use an archive-capable node.
RPC_PRIORITY_URL=
# Normal follow and receipt polling, in milliseconds (RH has approximately 0.1-second blocks).
VIEM_POLL_MS=750
# Timestamp anchor header spacing. Boundary intervals always fetch exact headers.
ANCHOR_SPACING=100
# LOWEST endpoint head minus this many blocks is the indexing frontier.
FOLLOW_MARGIN=20
# Initial getLogs span; refused ranges are recursively bisected down to one block.
LOG_CHUNK_BLOCKS=10000
# Endpoint backoff base, exponential up to 30 seconds.
RPC_BACKOFF_MS=1000
# Timeout of one RPC request in milliseconds.
RPC_TIMEOUT_MS=15000

# RULES: quotes are decimal IMD (18 decimals), never USD. Zero means no minimum.
MIN_BUY_QUOTE=0
MIN_PAYOUT_QUOTE=0
# Each payRound contains no more than this number of recipients (default 200).
MAX_RECIPIENTS_PER_TX=200
# Comma-separated addresses in addition to built-in system, burn and contract exclusions.
EXCLUDED_ADDRESSES=
# Epoch=900s, TWAP=180s, loss exponent=1, pct exponent=0, round cap=1/3,
# cumulative cap=1 are locked in code; there are no environment overrides for them.

# OPS: fraction in [0,1] of NEW pouch receipts (never team funds or rolled funds).
OPS_SKIM_FRACTION=0
# One-time IMD reserve, accrued from available pouch receipts after skim until fully filled.
DEX_RESERVE_QUOTE=0
# Alert when indexing or an unfinished round has stalled this many seconds.
STALL_SECONDS=300
# Telegram heartbeat interval in seconds.
HEARTBEAT_SECONDS=3600

# EXEC: a total round above this IMD amount is refused and alerted, never silently clipped.
MAX_ROUND_PAYOUT_QUOTE=100000
# Empty uses DATA_DIR/PAUSE. Creating this file stops every new broadcast, including retries.
PAUSE_FILE=
# Required mined confirmations for every transaction.
CONFIRMATION_BLOCKS=5
# Receipt timeout in milliseconds; a timeout remains pending and reuses the same signed tx.
TX_TIMEOUT_MS=120000

# Optional Telegram notifications; supply bot token as an environment secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Internal data/API listener. Put a reverse proxy in front if public access is needed.
API_HOST=127.0.0.1
API_PORT=8787
# USD DISPLAY ONLY, polled every 60s. ETH/IMD spot pool details come from launch.json.
COINGECKO_ETH_URL='https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd'
# Optional Dexscreener pair endpoint for a verified ETH/WETH base pair, used as fallback.
DEXSCREENER_ETH_URL=

# The supplied pm2 launcher defaults this to DATA_DIR/private/pm2. Use a dedicated home.
# PM2_HOME=
# The launcher forces both PM2 environment dump destinations to /dev/null, including signal exits.
# PM2_DUMP_FILE_PATH=/dev/null
# PM2_DUMP_BACKUP_FILE_PATH=/dev/null
